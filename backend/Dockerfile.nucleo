# syntax=docker/dockerfile:1
# Núcleo de SIEASAS: backend/app sin cambios (autenticación /auth/* y health). En Docker el
# gateway solo le envía /auth/* y /health; las rutas /ejecutivo/* las atienden los cuatro
# microservicios. Contexto de construcción: backend/
ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    FORWARDED_ALLOW_IPS=127.0.0.1
RUN useradd --create-home --uid 10001 sgsc
WORKDIR /app
# Mismas versiones que requirements.lock.txt, fijadas con hashes y solo paquetes precompilados.
COPY requirements.docker.lock /tmp/requirements.lock
RUN pip install --only-binary :all: --require-hashes --no-deps -r /tmp/requirements.lock && rm /tmp/requirements.lock
COPY app ./app
COPY manage.py ./manage.py
COPY migrations ./migrations
USER sgsc
EXPOSE 8000
# --proxy-headers con la IP del gateway: el límite de intentos por IP usa la IP real del
# cliente y no la del gateway.
CMD ["sh", "-c", "exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=\"$FORWARDED_ALLOW_IPS\""]
